{
  "profileVersion": "1.5",
  "contractVersion": "1.15.0",
  "applicationProfiles": [
    "standalone-model-driven",
    "dynamics-sales-extension",
    "dynamics-customer-service-extension",
    "dynamics-field-service-extension",
    "generic-dataverse-solution"
  ],
  "discovery": {
    "defaultMode": "demo-builder",
    "requiredQuestions": 6,
    "coreQuestions": 11,
    "architectureIntakeQuestions": 7,
    "architectureIntakeRequired": false,
    "modes": {
      "demo-builder": {
        "default": true,
        "explicitSelectionRequired": false,
        "questionBudget": 6,
        "questions": [
          "idea-and-business-outcome",
          "primary-user-and-top-task",
          "data-to-track",
          "experience-and-lifecycle",
          "demo-success-and-sample-data",
          "target-environment-and-solution-output"
        ],
        "inferTechnicalDesign": true,
        "consolidatedRecommendationConfirmation": true,
        "controls": [
          "application-profile-recommendation",
          "table-and-form-strategy-recommendation",
          "entry-point-and-landing-view-recommendation",
          "power-apps-grid-recommendation",
          "review-app-and-navigation-recommendation",
          "relationship-and-report-recommendation",
          "solution-identity-recommendation"
        ],
        "forbiddenPrompts": [
          "disposable-environment-confirmation",
          "destructive-cleanup-approval",
          "retention-policy",
          "rerun-proof-engineering",
          "acceptance-run-source-tag"
        ]
      },
      "advanced-builder": {
        "default": false,
        "explicitSelectionRequired": true,
        "questionBudget": 40,
        "questions": [
          "core-discovery",
          "architecture-intent",
          "entity-mapping",
          "user-tasks",
          "relationship-design",
          "report-scoping",
          "demo-data-design",
          "source-control"
        ],
        "inferTechnicalDesign": false,
        "consolidatedRecommendationConfirmation": false,
        "controls": [
          "application-profile",
          "table-strategy",
          "form-strategy",
          "entry-point-table",
          "named-landing-view",
          "power-apps-grid-all-views-and-inline-editing",
          "review-app-artifacts",
          "navigation-group",
          "solution-and-publisher-identity",
          "relationship-cardinality-requiredness-and-cascade",
          "report-mappings",
          "demo-data-scope"
        ],
        "forbiddenPrompts": [
          "disposable-environment-confirmation",
          "destructive-cleanup-approval",
          "retention-policy",
          "rerun-proof-engineering"
        ]
      },
      "framework-acceptance": {
        "default": false,
        "explicitSelectionRequired": true,
        "questionBudget": 48,
        "questions": [
          "advanced-builder-intake",
          "authorized-environment",
          "isolation-and-naming",
          "acceptance-data-and-hero-records",
          "idempotent-rerun-proof",
          "retention-and-cleanup",
          "acceptance-evidence"
        ],
        "inferTechnicalDesign": false,
        "consolidatedRecommendationConfirmation": false,
        "controls": [
          "all-advanced-builder-controls",
          "disposable-environment-confirmation",
          "timestamped-solution-name",
          "acceptance-publisher-prefix",
          "acceptance-run-source-tag",
          "hero-record-labels",
          "rerun-proof-engineering",
          "retention-policy",
          "destructive-cleanup-approval",
          "acceptance-evidence-plan"
        ],
        "forbiddenPrompts": []
      }
    },
    "optionalQuestionModules": {
      "business-process-flow": true,
      "table-strategy": true,
      "solution-identity": true,
      "reporting": true,
      "retrofit": true,
      "source-control": true,
      "user-tasks": true,
      "demo-data": true,
      "grid-controls": true,
      "choice-presentations": true
    }
  },
  "acceleratorRecommendations": {
    "enabled": false,
    "environmentFlag": "FAST_ENABLED",
    "explicitSwitch": "EnableAcceleratorRecommendations",
    "preferenceSelector": {
      "enabledByDefault": false,
      "offeredWhenExplicitlyEnabled": true,
      "parameter": "AcceleratorPreference",
      "choices": ["evaluate", "fully-custom", "prefer-fast"],
      "futureDefaultRolloutRequiresContractChange": true
    },
    "integrationPoint": "post-discovery-pre-architecture-finalization",
    "service": "scripts/accelerators/wizard-accelerator-integration.ps1",
    "analysisSchema": "schemas/accelerators/requirements-analysis.schema.json",
    "decisionSchema": "schemas/accelerators/architecture-decision.schema.json",
    "preferenceSchema": "schemas/accelerators/accelerator-preference.schema.json",
    "packageManifestSchema": "schemas/accelerators/package-input-manifest.schema.json",
    "requiresExplicitArchitectureApproval": true,
    "fullyCustomAlwaysAvailable": true,
    "dataverseGenerationConnected": false
  },
  "acceleratorBuildPlanning": {
    "enabled": false,
    "explicitSwitch": "EnableDryRunBuildPlanning",
    "service": "scripts/accelerators/build-planning-adapter.ps1",
    "command": "scripts/accelerators/invoke-accelerator-build-plan.ps1",
    "planSchema": "schemas/accelerators/build-plan.schema.json",
    "projectionSchema": "schemas/accelerators/build-plan-projection.schema.json",
    "requiresApprovedArchitectureArtifact": true,
    "providerNeutral": true,
    "dryRunOnly": true,
    "buildExecutionConnected": false,
    "dataverseConnected": false
  },
  "executionReadiness": {
    "enabled": false,
    "explicitSwitch": "EnableExecutionReadiness",
    "orchestratorSwitch": "ExecutionReadinessOnly",
    "service": "scripts/accelerators/execution-readiness.ps1",
    "command": "scripts/accelerators/invoke-execution-readiness.ps1",
    "evidenceSchema": "schemas/accelerators/execution-evidence.schema.json",
    "reportSchema": "schemas/accelerators/execution-readiness.schema.json",
    "authorizationSchema": "schemas/accelerators/build-authorization.schema.json",
    "maximumEvidenceLifetimeHours": 24,
    "providerNeutral": true,
    "humanReviewOnly": true,
    "buildExecutionConnected": false,
    "dataverseConnected": false,
    "issuesAuthorization": false
  },
  "sourceControl": {
    "enabled": true,
    "branchPattern": "feature/<scenario-slug>",
    "checkpointCommits": true,
    "explicitFileStaging": true,
    "validateBeforeCommit": true,
    "requireApprovalBeforeCommit": true,
    "requireApprovalBeforePush": true,
    "requireRemoteVerificationAfterPush": true,
    "pullRequestHandoff": true
  },
  "architectureIntent": {
    "required": true,
    "gateBeforeDiscovery": true,
    "questions": [
      "tableStrategy: oob-only | custom-only | hybrid",
      "formStrategy: update-in-place | create-new-forms (only when oob tables used)",
      "entryPointTable: logical name of first screen table",
      "entryPointLandingView: saved-query name to resolve and attach",
      "powerAppsGrid: table-level all-views yes | no",
      "powerAppsGridInlineEditing: explicit yes | no when enabled",
      "reviewApp: create-or-update (required)"
    ]
  },
  "execution": {
    "coreModules": [
      "00-prereq-check.ps1",
      "10-auth-connect.ps1",
      "15-dry-validate.ps1",
      "20-build-tables.ps1",
      "30-build-columns.ps1",
      "40-build-relationships.ps1",
      "50-add-to-solution.ps1",
      "55-build-business-process-flows.ps1",
      "60-build-forms-views.ps1",
      "64-build-charts-dashboard.ps1",
      "62-build-app-module.ps1"
    ],
    "mandatoryPostBuildSteps": [
      "solution-inventory-collect",
      "solution-inventory-sync",
      "solution-membership-report",
      "publish",
      "66-seed-synthetic-data.ps1",
      "85-verify-idempotency.ps1",
      "95-export-unmanaged-solution.ps1",
      "80-post-build-analysis.ps1"
    ],
    "optionalModules": {
      "web-resources": {
        "enabled": true,
        "script": "65-build-web-resources.ps1"
      },
      "form-formatting": {
        "enabled": true,
        "script": "63-format-forms.ps1",
        "contract": "specs/<scenario-slug>/form-layouts.json",
        "defaultMode": "Preview",
        "applyRequiresApprovedPlanHash": true,
        "version1Scope": "wizard-owned-custom-main-forms"
      },
      "grid-controls": {
        "enabled": true,
        "script": "61-configure-power-apps-grid.ps1",
        "contract": "specs/<scenario-slug>/grid-controls.json",
        "defaultMode": "Preview",
        "applyMode": "Verify",
        "scope": "table-level-all-views",
        "mutation": "maker-handoff-only"
      },
      "choice-presentations": {
        "enabled": true,
        "script": "35-style-choice-options.ps1",
        "contract": "payloads/scenarios/<scenario-slug>/choice-presentations-*.json",
        "defaultMode": "Preview",
        "applyRequiresApprovedPlanHash": true,
        "scope": "wizard-owned-unmanaged-local-choices"
      },
      "demo-script": {
        "enabled": true,
        "script": "06-demo-script-wizard.ps1"
      },
      "demo-dry-run": {
        "enabled": true,
        "script": "07-demo-dry-run.ps1"
      }
    },
    "telemetry": {
      "enabled": true,
      "disclosed": true,
      "capturesPersonalIdentifiers": false,
      "localFolder": ".wizard-metrics",
      "optOutEnvironmentVariable": "WIZARD_METRICS_OPTOUT",
      "matrixScript": "81-build-progress-matrix.ps1",
      "estimatedMinutesSavedByStep": {
        "00": 5,
        "01": 8,
        "05": 20,
        "06": 12,
        "07": 8,
        "10": 20,
        "15": 10,
        "20": 25,
        "30": 20,
        "35": 10,
        "40": 20,
        "50": 15,
        "55": 18,
        "60": 30,
        "64": 20,
        "65": 20,
        "66": 15,
        "85": 10,
        "95": 10,
        "80": 10
      }
    }
  },
  "reliability": {
    "idempotentScripts": true,
    "payloadAsSourceOfTruth": true,
    "businessLabelsOnForms": true,
    "publishAfterMetadataUpdate": true,
    "tokenRefreshOn401": true,
    "exponentialBackoffOn429": true
  },
  "solutionInventory": {
    "enabled": true,
    "mandatory": true,
    "artifactCategories": [
      "tables",
      "columns",
      "relationships",
      "forms",
      "views",
      "model-driven-apps",
      "sitemap-updates",
      "web-resources",
      "dashboards",
      "charts"
    ],
    "optionalCategories": [
      "flows"
    ],
    "persistLogicalNamesAndIds": true,
    "membershipReportRequired": true,
    "blockExportOnMembershipFailure": true
  },
  "reviewApp": {
    "mandatory": true,
    "createOrUpdateEveryRun": true,
    "mustIncludeAllRunArtifacts": true,
    "entryPointRequired": true,
    "landingViewRequired": true,
    "publishAfterUpdate": true,
    "usabilityValidationRequired": true
  },
  "formStrategy": {
    "oobNoModification": "create-new-forms-on-oob-tables",
    "oobUpdateInPlace": "update-selected-oob-forms-only",
    "postUpdateOptimization": {
      "enforceSectionLabels": true,
      "enforceBusinessLabels": true,
      "removeLegacySectionsFromPriorRuns": true,
      "validateFormXmlAfterUpdate": true
    },
    "optionalSecondPass": {
      "contract": "form-layouts.json",
      "previewBeforeApply": true,
      "applyRequiresApprovedPlanHash": true,
      "wizardOwnedCustomMainFormsOnly": true,
      "supportedLayoutColumns": [1, 2, 3],
      "preserveExistingControls": true
    }
  },
  "validationGates": {
    "requireArchitectureIntentBeforeBuild": true,
    "requireEntryPointResolutionBeforeBuild": true,
    "requireLandingViewPlanBeforeBuild": true,
    "requireSpecKitBeforeBuild": true,
    "requireReportScopingBeforeBuild": true,
    "requireFolderContract": true,
    "requireDocsContractConsistency": true,
    "postBuildChecks": [
      "fields-exist-on-target-tables",
      "intended-forms-exist-with-correct-labels",
      "app-navigation-contains-entry-points",
      "target-solution-contains-required-components"
    ],
    "runSummaryRequired": true,
    "buildLogUpdateRequired": true
  },
  "conventions": {
    "payloadFolder": "payloads",
    "scenarioFolder": "specs",
    "bootstrapFolder": "scripts/bootstrap"
  }
}
