{
  "profileVersion": "1.2",
  "contractVersion": "1.8.0",
  "applicationProfiles": [
    "standalone-model-driven",
    "dynamics-sales-extension",
    "dynamics-customer-service-extension",
    "dynamics-field-service-extension",
    "generic-dataverse-solution"
  ],
  "discovery": {
    "defaultMode": "demo-builder",
    "requiredQuestions": 6,
    "coreQuestions": 11,
    "architectureIntakeQuestions": 7,
    "architectureIntakeRequired": false,
    "modes": {
      "demo-builder": {
        "default": true,
        "explicitSelectionRequired": false,
        "questionBudget": 6,
        "questions": [
          "idea-and-business-outcome",
          "primary-user-and-top-task",
          "data-to-track",
          "experience-and-lifecycle",
          "demo-success-and-sample-data",
          "target-environment-and-solution-output"
        ],
        "inferTechnicalDesign": true,
        "consolidatedRecommendationConfirmation": true,
        "controls": [
          "application-profile-recommendation",
          "table-and-form-strategy-recommendation",
          "entry-point-and-landing-view-recommendation",
          "review-app-and-navigation-recommendation",
          "relationship-and-report-recommendation",
          "solution-identity-recommendation"
        ],
        "forbiddenPrompts": [
          "disposable-environment-confirmation",
          "destructive-cleanup-approval",
          "retention-policy",
          "rerun-proof-engineering",
          "acceptance-run-source-tag"
        ]
      },
      "advanced-builder": {
        "default": false,
        "explicitSelectionRequired": true,
        "questionBudget": 40,
        "questions": [
          "core-discovery",
          "architecture-intent",
          "entity-mapping",
          "user-tasks",
          "relationship-design",
          "report-scoping",
          "demo-data-design",
          "source-control"
        ],
        "inferTechnicalDesign": false,
        "consolidatedRecommendationConfirmation": false,
        "controls": [
          "application-profile",
          "table-strategy",
          "form-strategy",
          "entry-point-table",
          "named-landing-view",
          "review-app-artifacts",
          "navigation-group",
          "solution-and-publisher-identity",
          "relationship-cardinality-requiredness-and-cascade",
          "report-mappings",
          "demo-data-scope"
        ],
        "forbiddenPrompts": [
          "disposable-environment-confirmation",
          "destructive-cleanup-approval",
          "retention-policy",
          "rerun-proof-engineering"
        ]
      },
      "framework-acceptance": {
        "default": false,
        "explicitSelectionRequired": true,
        "questionBudget": 48,
        "questions": [
          "advanced-builder-intake",
          "authorized-environment",
          "isolation-and-naming",
          "acceptance-data-and-hero-records",
          "idempotent-rerun-proof",
          "retention-and-cleanup",
          "acceptance-evidence"
        ],
        "inferTechnicalDesign": false,
        "consolidatedRecommendationConfirmation": false,
        "controls": [
          "all-advanced-builder-controls",
          "disposable-environment-confirmation",
          "timestamped-solution-name",
          "acceptance-publisher-prefix",
          "acceptance-run-source-tag",
          "hero-record-labels",
          "rerun-proof-engineering",
          "retention-policy",
          "destructive-cleanup-approval",
          "acceptance-evidence-plan"
        ],
        "forbiddenPrompts": []
      }
    },
    "optionalQuestionModules": {
      "business-process-flow": true,
      "table-strategy": true,
      "solution-identity": true,
      "reporting": true,
      "retrofit": true,
      "source-control": true,
      "user-tasks": true,
      "demo-data": true
    }
  },
  "sourceControl": {
    "enabled": true,
    "branchPattern": "feature/<scenario-slug>",
    "checkpointCommits": true,
    "explicitFileStaging": true,
    "validateBeforeCommit": true,
    "requireApprovalBeforeCommit": true,
    "requireApprovalBeforePush": true,
    "requireRemoteVerificationAfterPush": true,
    "pullRequestHandoff": true
  },
  "architectureIntent": {
    "required": true,
    "gateBeforeDiscovery": true,
    "questions": [
      "tableStrategy: oob-only | custom-only | hybrid",
      "formStrategy: update-in-place | create-new-forms (only when oob tables used)",
      "entryPointTable: logical name of first screen table",
      "entryPointLandingView: saved-query name to resolve and attach",
      "reviewApp: create-or-update (required)"
    ]
  },
  "execution": {
    "coreModules": [
      "00-prereq-check.ps1",
      "10-auth-connect.ps1",
      "15-dry-validate.ps1",
      "20-build-tables.ps1",
      "30-build-columns.ps1",
      "40-build-relationships.ps1",
      "50-add-to-solution.ps1",
      "55-build-business-process-flows.ps1",
      "60-build-forms-views.ps1",
      "62-build-app-module.ps1"
    ],
    "mandatoryPostBuildSteps": [
      "solution-inventory-collect",
      "solution-inventory-sync",
      "solution-membership-report",
      "publish",
      "80-post-build-analysis.ps1"
    ],
    "optionalModules": {
      "web-resources": {
        "enabled": true,
        "script": "65-build-web-resources.ps1"
      },
      "demo-script": {
        "enabled": true,
        "script": "06-demo-script-wizard.ps1"
      },
      "demo-dry-run": {
        "enabled": true,
        "script": "07-demo-dry-run.ps1"
      }
    },
    "telemetry": {
      "enabled": true,
      "disclosed": true,
      "capturesPersonalIdentifiers": false,
      "localFolder": ".wizard-metrics",
      "optOutEnvironmentVariable": "WIZARD_METRICS_OPTOUT",
      "matrixScript": "81-build-progress-matrix.ps1",
      "estimatedMinutesSavedByStep": {
        "00": 5,
        "01": 8,
        "05": 20,
        "06": 12,
        "07": 8,
        "10": 20,
        "15": 10,
        "20": 25,
        "30": 20,
        "40": 20,
        "50": 15,
        "55": 18,
        "60": 30,
        "65": 20,
        "80": 10
      }
    }
  },
  "reliability": {
    "idempotentScripts": true,
    "payloadAsSourceOfTruth": true,
    "businessLabelsOnForms": true,
    "publishAfterMetadataUpdate": true,
    "tokenRefreshOn401": true,
    "exponentialBackoffOn429": true
  },
  "solutionInventory": {
    "enabled": true,
    "mandatory": true,
    "artifactCategories": [
      "tables",
      "columns",
      "relationships",
      "forms",
      "views",
      "model-driven-apps",
      "sitemap-updates",
      "web-resources"
    ],
    "optionalCategories": [
      "dashboards",
      "charts",
      "flows"
    ],
    "persistLogicalNamesAndIds": true,
    "membershipReportRequired": true,
    "blockExportOnMembershipFailure": true
  },
  "reviewApp": {
    "mandatory": true,
    "createOrUpdateEveryRun": true,
    "mustIncludeAllRunArtifacts": true,
    "entryPointRequired": true,
    "landingViewRequired": true,
    "publishAfterUpdate": true,
    "usabilityValidationRequired": true
  },
  "formStrategy": {
    "oobNoModification": "create-new-forms-on-oob-tables",
    "oobUpdateInPlace": "update-selected-oob-forms-only",
    "postUpdateOptimization": {
      "enforceSectionLabels": true,
      "enforceBusinessLabels": true,
      "removeLegacySectionsFromPriorRuns": true,
      "validateFormXmlAfterUpdate": true
    }
  },
  "validationGates": {
    "requireArchitectureIntentBeforeBuild": true,
    "requireEntryPointResolutionBeforeBuild": true,
    "requireLandingViewPlanBeforeBuild": true,
    "requireSpecKitBeforeBuild": true,
    "requireReportScopingBeforeBuild": true,
    "requireFolderContract": true,
    "requireDocsContractConsistency": true,
    "postBuildChecks": [
      "fields-exist-on-target-tables",
      "intended-forms-exist-with-correct-labels",
      "app-navigation-contains-entry-points",
      "target-solution-contains-required-components"
    ],
    "runSummaryRequired": true,
    "buildLogUpdateRequired": true
  },
  "conventions": {
    "payloadFolder": "payloads",
    "scenarioFolder": "specs",
    "bootstrapFolder": "scripts/bootstrap"
  }
}
