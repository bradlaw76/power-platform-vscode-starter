{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate framework distribution inventory - never update authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "inventoryVersion", "repository", "repositoryUrl", "sourceCommit", "policySha256", "publisherVerified", "automaticApply", "fileCount", "totalBytes", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "candidate-framework-distribution" },
    "inventoryVersion": { "const": "1.0.0" },
    "repository": { "const": "bradlaw76/power-platform-vscode-starter" },
    "repositoryUrl": { "const": "https://github.com/bradlaw76/power-platform-vscode-starter" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "policySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publisherVerified": { "const": false },
    "automaticApply": { "const": false },
    "fileCount": { "type": "integer", "minimum": 1, "maximum": 512 },
    "totalBytes": { "type": "integer", "minimum": 0, "maximum": 33554432 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "category", "consumerAction", "gitMode", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9._ /-]+$" },
          "category": { "enum": ["core-runtime", "helper", "schema-profile", "copilot-asset", "claude-asset", "shared-doc", "validation"] },
          "consumerAction": { "const": "explicit-review" },
          "gitMode": { "enum": ["100644", "100755"] },
          "size": { "type": "integer", "minimum": 0, "maximum": 2097152 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
