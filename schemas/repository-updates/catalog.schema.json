{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "remote", "branch", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "remote": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "branch": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "category", "scope", "paths", "guidance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "enum": ["runtime", "governance", "compatibility-review", "optional-feature", "documentation", "experimental", "validation"] },
          "scope": { "enum": ["all", "selected"] },
          "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "guidance": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
