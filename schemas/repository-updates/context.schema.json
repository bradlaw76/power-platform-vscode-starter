{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioSlug", "enabledCapabilities", "disabledCapabilities"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "scenarioSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "enabledCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "disabledCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
