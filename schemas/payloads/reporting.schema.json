{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["Enabled", "Charts", "Dashboard"],
  "properties": {
    "Enabled": { "type": "boolean" },
    "ReportRequest": {
      "type": "string",
      "minLength": 1
    },
    "TargetAppUniqueName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "OutputTargets": {
      "type": "array",
      "items": {
        "enum": ["fetchxml-preview", "native-chart-dashboard", "html-web-resource"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "Charts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Name", "TableLogicalName", "CategoryField", "AggregateField", "Aggregate"],
        "properties": {
          "Name": { "type": "string", "minLength": 1 },
          "TableLogicalName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "CategoryField": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "AggregateField": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "Aggregate": { "enum": ["count", "countcolumn", "sum", "avg", "min", "max"] },
          "ChartType": { "enum": ["bar", "column", "pie", "doughnut"] },
          "Filters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["Field", "Operator"],
              "properties": {
                "Field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "Operator": { "enum": ["eq", "ne", "gt", "ge", "lt", "le", "null", "not-null"] },
                "Value": { "type": ["string", "number", "boolean", "null"] }
              }
            }
          }
        }
      }
    },
    "Dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Name", "ChartNames"],
      "properties": {
        "Name": { "type": "string", "minLength": 1 },
        "ChartNames": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}