{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://power-platform-vscode-starter.local/schemas/payloads/relationships.schema.json",
  "title": "Dataverse relationships payload",
  "type": "object",
  "required": [
    "Relationships"
  ],
  "properties": {
    "Relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "SchemaName",
              "RelationshipDefinition"
            ],
            "properties": {
              "SchemaName": {
                "$ref": "#/definitions/logicalName"
              },
              "RelationshipDefinition": {
                "$ref": "#/definitions/relationshipDefinition"
              }
            },
            "additionalProperties": true
          },
          {
            "$ref": "#/definitions/relationshipDefinition"
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "logicalName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "relationshipDefinition": {
      "type": "object",
      "required": [
        "SchemaName",
        "ReferencedEntity",
        "ReferencedAttribute",
        "ReferencingEntity",
        "ReferencingAttribute"
      ],
      "properties": {
        "@odata.type": {
          "type": "string",
          "minLength": 1
        },
        "SchemaName": {
          "$ref": "#/definitions/logicalName"
        },
        "ReferencedEntity": {
          "$ref": "#/definitions/logicalName"
        },
        "ReferencedAttribute": {
          "$ref": "#/definitions/logicalName"
        },
        "ReferencingEntity": {
          "$ref": "#/definitions/logicalName"
        },
        "ReferencingAttribute": {
          "$ref": "#/definitions/logicalName"
        },
        "CascadeConfiguration": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}