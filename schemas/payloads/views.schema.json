{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["Views"],
  "properties": {
    "Views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["TableLogicalName", "Name", "Disposition", "Columns"],
        "properties": {
          "TableLogicalName": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "Name": {
            "type": "string",
            "minLength": 1
          },
          "Disposition": {
            "enum": ["create-custom", "adopt-generated-active", "explicit-decision-required"]
          },
          "DecisionReason": {
            "type": "string",
            "minLength": 1
          },
          "Columns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "Filter": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Attribute", "Operator"],
            "properties": {
              "Attribute": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "Operator": {
                "enum": ["eq", "ne", "gt", "ge", "lt", "le", "null", "not-null"]
              },
              "Value": {
                "type": ["string", "number", "boolean", "null"]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "Operator": {
                      "enum": ["null", "not-null"]
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": ["Value"]
                  }
                },
                "else": {
                  "required": ["Value"]
                }
              }
            ]
          },
          "Sort": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Attribute", "Descending"],
            "properties": {
              "Attribute": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "Descending": {
                "type": "boolean"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "Disposition": {
                  "const": "explicit-decision-required"
                }
              }
            },
            "then": {
              "required": ["DecisionReason"]
            }
          }
        ]
      }
    }
  }
}
