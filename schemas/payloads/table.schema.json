{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://power-platform-vscode-starter.local/schemas/payloads/table.schema.json",
  "title": "Dataverse table payload",
  "type": "object",
  "required": [
    "EntityDefinition"
  ],
  "properties": {
    "EntityDefinition": {
      "type": "object",
      "required": [
        "SchemaName",
        "DisplayName",
        "DisplayCollectionName",
        "OwnershipType",
        "IsActivity"
      ],
      "properties": {
        "SchemaName": {
          "$ref": "#/definitions/logicalName"
        },
        "DisplayName": {
          "$ref": "#/definitions/label"
        },
        "DisplayCollectionName": {
          "$ref": "#/definitions/label"
        },
        "Description": {
          "$ref": "#/definitions/label"
        },
        "OwnershipType": {
          "type": "string",
          "minLength": 1
        },
        "IsActivity": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "logicalName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "label": {
      "type": "object",
      "required": [
        "LocalizedLabels"
      ],
      "properties": {
        "LocalizedLabels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "Label",
              "LanguageCode"
            ],
            "properties": {
              "Label": {
                "type": "string",
                "minLength": 1
              },
              "LanguageCode": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}