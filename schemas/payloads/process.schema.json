{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://power-platform-vscode-starter.local/schemas/payloads/process.schema.json",
  "title": "Dataverse business process flow payload",
  "type": "object",
  "required": [
    "Enabled"
  ],
  "properties": {
    "Enabled": {
      "type": "boolean"
    },
    "BusinessProcessFlowName": {
      "type": "string",
      "minLength": 1
    },
    "PrimaryProcessEntity": {
      "$ref": "#/definitions/logicalName"
    },
    "FailIfBpfDefinitionIncomplete": {
      "type": "boolean"
    },
    "PreferUpdateExistingBpf": {
      "type": "boolean"
    },
    "CrossTableProgression": {
      "type": "boolean"
    },
    "FormIntegration": {
      "type": "object",
      "required": [
        "TargetFormName"
      ],
      "properties": {
        "TargetFormName": {
          "type": "string",
          "minLength": 1
        },
        "RequireMainForm": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "StageDefinitions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "Order",
          "StageName",
          "EntityLogicalName",
          "RequiredFields",
          "EntryCriteria",
          "ExitCriteria"
        ],
        "properties": {
          "Order": {
            "type": "integer",
            "minimum": 1
          },
          "StageName": {
            "type": "string",
            "minLength": 1
          },
          "EntityLogicalName": {
            "$ref": "#/definitions/logicalName"
          },
          "RequiredFields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/logicalName"
            },
            "uniqueItems": true
          },
          "EntryCriteria": {
            "type": "string",
            "minLength": 1
          },
          "ExitCriteria": {
            "type": "string",
            "minLength": 1
          },
          "RelationshipLogicalName": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "Enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "BusinessProcessFlowName",
          "PrimaryProcessEntity",
          "FormIntegration",
          "StageDefinitions"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "definitions": {
    "logicalName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    }
  }
}