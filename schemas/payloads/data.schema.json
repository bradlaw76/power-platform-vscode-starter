{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["Enabled", "SourceTag", "SourceTagField", "Tables"],
  "properties": {
    "Enabled": { "type": "boolean" },
    "SourceTag": { "type": "string", "minLength": 1 },
    "SourceTagField": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "Tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["TableLogicalName", "NaturalKey", "Records"],
        "properties": {
          "TableLogicalName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "NaturalKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "Records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["Key", "Values"],
              "additionalProperties": false,
              "properties": {
                "Key": { "type": "string", "minLength": 1 },
                "Values": { "type": "object", "minProperties": 1 },
                "Lookups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["Field", "TargetTable", "TargetKey", "TargetValue"],
                    "properties": {
                      "Field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                      "TargetTable": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                      "TargetKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                      "TargetValue": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}