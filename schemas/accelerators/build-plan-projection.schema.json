{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accelerator Build Plan Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "planId",
    "scenarioSlug",
    "decisionId",
    "architecture",
    "dryRun",
    "items"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "artifactType": {
      "enum": [
        "component-reuse-extension",
        "new-component-creation",
        "integration-automation",
        "ordered-dependency-graph",
        "readiness-authorization",
        "blocked-actions-remediation",
        "rollback-recovery",
        "requirement-build-traceability"
      ]
    },
    "planId": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scenarioSlug": {"type": "string"},
    "decisionId": {"type": "string"},
    "architecture": {"enum": ["fast-based", "hybrid", "fully-custom"]},
    "dryRun": {"const": true},
    "items": {"type": "array"}
  }
}
