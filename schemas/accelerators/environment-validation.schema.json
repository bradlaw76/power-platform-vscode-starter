{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accelerator Environment Validation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerId",
    "scenarioSlug",
    "level",
    "status",
    "readinessStatus",
    "validatedAtUtc",
    "catalogSnapshotId",
    "requiredModules",
    "selectedPackages",
    "installedModules",
    "dependencyAssessment",
    "missingComponents",
    "incompatibleComponents",
    "checks",
    "evidence",
    "limitations",
    "recommendedNextAction",
    "expiresAtUtc"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "minLength": 1},
    "providerId": {"type": "string", "minLength": 1},
    "scenarioSlug": {"type": "string", "minLength": 1},
    "level": {
      "enum": ["catalog-compatibility", "environment-preflight", "installation-verification"]
    },
    "status": {
      "enum": ["ready", "action-required", "incompatible", "unverified"]
    },
    "readinessStatus": {
      "enum": ["ready", "action-required", "incompatible", "unverified"]
    },
    "validatedAtUtc": {"type": "string", "format": "date-time"},
    "expiresAtUtc": {"type": "string", "format": "date-time"},
    "catalogSnapshotId": {"type": "string", "minLength": 1},
    "environment": {
      "type": ["object", "null"],
      "properties": {
        "environmentId": {"type": "string"},
        "environmentUrl": {"type": "string"},
        "tenantId": {"type": "string"},
        "organizationVersion": {"type": "string"}
      }
    },
    "requiredModules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/moduleEvidence"}
    },
    "selectedPackages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/moduleEvidence"}
    },
    "installedModules": {"type": "array"},
    "dependencyAssessment": {"type": "array"},
    "missingComponents": {"type": "array"},
    "incompatibleComponents": {"type": "array"},
    "checks": {"type": "array"},
    "evidence": {
      "type": ["object", "null"]
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommendedNextAction": {
      "type": "string",
      "minLength": 1
    },
    "authorization": {
      "type": ["object", "null"]
    }
  },
  "$defs": {
    "moduleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "moduleId",
        "solutionUniqueName",
        "version",
        "sha256"
      ],
      "properties": {
        "packageId": {"type": "string", "minLength": 1},
        "moduleId": {"type": "string", "minLength": 1},
        "solutionUniqueName": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
