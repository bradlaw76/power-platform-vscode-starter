{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accelerator Environment Validation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerId",
    "scenarioSlug",
    "level",
    "status",
    "validatedAtUtc",
    "catalogSnapshotId",
    "selectedPackages",
    "checks",
    "limitations",
    "expiresAtUtc"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "minLength": 1},
    "providerId": {"type": "string", "minLength": 1},
    "scenarioSlug": {"type": "string", "minLength": 1},
    "level": {
      "enum": ["catalog-compatibility", "environment-preflight", "installation-verification"]
    },
    "status": {
      "enum": ["ready", "action-required", "incompatible", "unverified"]
    },
    "validatedAtUtc": {"type": "string", "format": "date-time"},
    "expiresAtUtc": {"type": "string", "format": "date-time"},
    "catalogSnapshotId": {"type": "string", "minLength": 1},
    "environment": {
      "type": ["object", "null"]
    },
    "selectedPackages": {
      "type": "array",
      "minItems": 1
    },
    "checks": {"type": "array"},
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "authorization": {
      "type": ["object", "null"]
    }
  }
}
