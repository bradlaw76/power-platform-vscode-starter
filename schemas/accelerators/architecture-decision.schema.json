{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wizard Accelerator Architecture Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "scenarioSlug",
    "wizardMode",
    "evaluationStatus",
    "analysisId",
    "catalogSnapshotId",
    "recommendedOption",
    "selectedOption",
    "explicitApproval",
    "rationale",
    "selectedPackages",
    "environmentReadiness",
    "fastDependentExecutionAllowed",
    "fullyCustomExecutionAllowed",
    "recordedAtUtc"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "decisionId": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scenarioSlug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "wizardMode": {
      "enum": ["demo-builder", "advanced-builder", "framework-acceptance"]
    },
    "evaluationStatus": {"enum": ["evaluated", "catalog-unavailable"]},
    "analysisId": {"type": "string"},
    "catalogSnapshotId": {"type": "string"},
    "recommendedOption": {
      "enum": ["fast-based", "hybrid", "fully-custom"]
    },
    "selectedOption": {
      "enum": ["fast-based", "hybrid", "fully-custom"]
    },
    "explicitApproval": {"const": true},
    "rationale": {"type": "string", "minLength": 1},
    "selectedPackages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleId", "packageId", "version", "sha256"],
        "properties": {
          "moduleId": {"type": "string"},
          "packageId": {"type": "string"},
          "version": {"type": "string"},
          "sha256": {"type": "string"}
        }
      }
    },
    "environmentReadiness": {"type": "object"},
    "fastDependentExecutionAllowed": {"type": "boolean"},
    "fullyCustomExecutionAllowed": {"type": "boolean"},
    "recordedAtUtc": {"type": "string", "format": "date-time"}
  }
}
